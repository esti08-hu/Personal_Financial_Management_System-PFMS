# Server Configuration
PORT=<PORT>
CORS_ORIGINS=<CORS_ORIGINS>

# Database Configuration
POSTGRES_HOST=<POSTGRES_HOST>
POSTGRES_PORT=<POSTGRES_PORT>
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
POSTGRES_DB=<POSTGRES_DB>

# JWT Configuration
JWT_ACCESS_TOKEN_SECRET=<JWT_ACCESS_TOKEN_SECRET>
JWT_REFRESH_TOKEN_SECRET=<JWT_REFRESH_TOKEN_SECRET>
JWT_ACCESS_TOKEN_EXPIRATION_TIME=<JWT_ACCESS_TOKEN_EXPIRATION_TIME>
JWT_REFRESH_TOKEN_EXPIRATION_TIME=<JWT_REFRESH_TOKEN_EXPIRATION_TIME>

# Email Configuration
EMAIL_SERVICE=<EMAIL_SERVICE>
EMAIL_USER=<EMAIL_USER>
EMAIL_PASSWORD=<EMAIL_PASSWORD>

# Email Verification Configuration
EMAIL_VERIFICATION_SECRET=<EMAIL_VERIFICATION_SECRET>
EMAIL_VERIFICATION_SECRET_EXPIRATION=<EMAIL_VERIFICATION_SECRET_EXPIRATION>
EMAIL_CONFIRMATION_URL=http://localhost:3001/api/v1/email-confirmation/confirm

# Google OAuth Configuration (Required)
GOOGLE_AUTH_CLIENT_ID=<GOOGLE_AUTH_CLIENT_ID>
GOOGLE_AUTH_CLIENT_SECRET=<GOOGLE_AUTH_CLIENT_SECRET>

# Gemini API Configuration (Required)
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_MODEL=<GEMINI_MODEL>

# Google API Configuration (Required)
GOOGLE_API_KEY=<GOOGLE_API_KEY>
